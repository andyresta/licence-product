# Copy to .env and fill in real values. .env itself is gitignored — never commit it.

APP_PORT=7575

# Keyword=value DSN (avoids URL-encoding special characters in the password).
# host.docker.internal reaches a Postgres running on the host machine — see
# docker-compose.yml's extra_hosts entry for why this also works on Linux.
DATABASE_URL=host=host.docker.internal port=5432 user=CHANGEME password=CHANGEME dbname=CHANGEME sslmode=disable

# Generate with: go run ./cmd/genkey — never commit the real value.
LICENSE_SIGNING_SEED=

# Any random string — generate with: openssl rand -hex 32
SESSION_SECRET=

# username:password — creates the first admin account on first startup only.
BOOTSTRAP_ADMIN=admin:CHANGEME
